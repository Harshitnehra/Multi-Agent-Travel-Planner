APP_NAME="TripMate"
APP_VERSION="3.0.0"
APP_ENV="development"
DATABASE_URL=
# Optional separate URL for application-owned trip data. Defaults to DATABASE_URL,
# then to a local SQLite database when both values are empty.
APP_DATABASE_URL=
GROQ_API_KEY=
GROQ_MODEL="openai/gpt-oss-120b"
AVIATIONSTACK_API_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
DEFAULT_ORIGIN_IATA="DEL"
REQUEST_TIMEOUT_SECONDS=20

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="travel-agent-project"

PAYMENT_MODE=test
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
